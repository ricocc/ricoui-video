{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "snap-cn-ui",
  "homepage": "https://snapcn.dev",
  "items": [
    {
      "name": "snap-cn-ui",
      "type": "registry:lib",
      "title": "snap-cn UI Core",
      "description": "Shared timeline-fold hook, theme context, and color math for snap-cn UI primitives.",
      "dependencies": ["remotion", "culori"],
      "files": [
        {
          "path": "core/timeline.ts",
          "type": "registry:lib",
          "target": "lib/snap-cn-ui/timeline.ts"
        },
        {
          "path": "core/theme.ts",
          "type": "registry:lib",
          "target": "lib/snap-cn-ui/theme.ts"
        },
        {
          "path": "core/color.ts",
          "type": "registry:lib",
          "target": "lib/snap-cn-ui/color.ts"
        },
        {
          "path": "core/motion.ts",
          "type": "registry:lib",
          "target": "lib/snap-cn-ui/motion.ts"
        },
        {
          "path": "core/types.ts",
          "type": "registry:lib",
          "target": "lib/snap-cn-ui/types.ts"
        },
        {
          "path": "core/index.ts",
          "type": "registry:lib",
          "target": "lib/snap-cn-ui/index.ts"
        }
      ]
    },
    {
      "name": "caret",
      "type": "registry:component",
      "title": "UI Caret",
      "description": "A blinking text caret — a controlled vertical bar, or a pure motion atom that blinks deterministically from useCurrentFrame.",
      "dependencies": ["remotion"],
      "registryDependencies": [],
      "files": [
        {
          "path": "caret/index.tsx",
          "type": "registry:component",
          "target": "components/snap-cn/caret.tsx"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:component",
      "title": "UI Input",
      "description": "A text input whose idle/hover/active/typing/invalid state is a pure function of the timeline; the focus ring, border, caret, and value reveal are keyframed presets.",
      "dependencies": ["remotion"],
      "registryDependencies": ["@snap-cn-ui/snap-cn-ui", "@snap-cn-ui/caret"],
      "files": [
        {
          "path": "input/index.tsx",
          "type": "registry:component",
          "target": "components/snap-cn/input.tsx"
        },
        {
          "path": "input/use-input-transition.ts",
          "type": "registry:component",
          "target": "components/snap-cn/use-input-transition.ts"
        }
      ]
    }
  ]
}
